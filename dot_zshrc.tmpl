# START OF FILE

{{- /* Path variable definitions for OS differences */ -}}
{{- if eq .chezmoi.os "darwin" }}
export HOMEBREW_PREFIX="/opt/homebrew"
export ZPLUG_HOME="$HOMEBREW_PREFIX/opt/zplug"
export PNPM_HOME="$HOME/Library/pnpm"
export CONDA_BASE="$HOMEBREW_PREFIX/Caskroom/miniconda/base"
{{- else if eq .chezmoi.os "linux" }}
export HOMEBREW_PREFIX="/home/linuxbrew/.linuxbrew"
export ZPLUG_HOME="$HOMEBREW_PREFIX/opt/zplug"
export PNPM_HOME="$HOME/.local/share/pnpm"
export CONDA_BASE="$HOME/miniconda3"
{{- end }}

export XDG_CONFIG_HOME="$HOME/.config"

# pnpm (must be before Homebrew to override Node.js)
case ":$PATH:" in
  *":$PNPM_HOME:"*) ;;
  *) export PATH="$PNPM_HOME:$PATH" ;;
esac

# Add Homebrew to PATH early (critical for Linux)
if [[ -d "$HOMEBREW_PREFIX/bin" ]]; then
    export PATH="$HOMEBREW_PREFIX/bin:$HOMEBREW_PREFIX/sbin:$PATH"
fi

# START SECTION Powerlevel10k autogenerated configuration
# Enable Powerlevel10k instant prompt. Should stay close to the top of ~/.zshrc.
# Initialization code that may require console input (password prompts, [y/n]
# confirmations, etc.) must go above this block; everything else may go below.
if [[ -r "${XDG_CACHE_HOME:-$HOME/.cache}/p10k-instant-prompt-${(%):-%n}.zsh" ]]; then
  source "${XDG_CACHE_HOME:-$HOME/.cache}/p10k-instant-prompt-${(%):-%n}.zsh"
fi
# END SECTION Powerlevel10k autogenerated configuration


# START SECTION brew autocompletion
autoload -Uz compinit
if [[ -n ${ZDOTDIR:-$HOME}/.zcompdump(#qN.mw-1) ]]; then
    compinit -C
else
    compinit
fi

# END SECTION brew autocompletion


export DO_NOT_TRACK=1


# START SECTION Zplug
if [[ -f "$ZPLUG_HOME/init.zsh" ]]; then
    source "$ZPLUG_HOME/init.zsh"

    zstyle ':completion:*' matcher-list 'm:{a-z}={A-Za-z}'
    zplug romkatv/powerlevel10k, as:theme, depth:1
    zplug "aloxaf/fzf-tab"
    zplug "zsh-users/zsh-syntax-highlighting", defer:2
    #zplug "agkozak/zsh-z"

    if ! zplug check; then
        zplug install
    fi
    zplug load
fi
# END SECTION Zplug

# START SECTION zoxide
if command -v zoxide &> /dev/null; then
    eval "$(zoxide init zsh)"
fi
# END SECTION zoxide



# START SECTION alias
alias ls='ls --color --group-directories-first'
alias l='eza --group-directories-first --git -lah'
alias ll='eza --group-directories-first --git -lh'
alias gg='lazygit'
alias o='opencode'
alias g='git'
cm() {
  if [[ "$1" == "cd" ]]; then
    shift
    cd "$(chezmoi source-path "$@")"
  else
    command chezmoi "$@"
  fi
}
fresh() {
    if [ $# -eq 0 ]; then
        command fresh .
    else
        command fresh "$@"
    fi
}

zed() {
    if [ $# -eq 0 ]; then
        command zed .
    else
        command zed "$@"
    fi
}

alias sublime='subl'
alias cat='bat --paging=never --plain'
export BAT_THEME="Dracula"
export PAGER="moor"
export BAT_PAGER="moor"
export MOOR="--no-linenumbers --quit-if-one-screen"
export MANPAGER="moor -colors auto"
export LESS_TERMCAP_mb={{ `$'\e[1;31m'` }}
export LESS_TERMCAP_md={{ `$'\e[1;36m'` }}
export LESS_TERMCAP_me={{ `$'\e[0m'` }}
export LESS_TERMCAP_us={{ `$'\e[1;32m'` }}
export LESS_TERMCAP_ue={{ `$'\e[0m'` }}

# START SECTION Powerlevel10k autogenerated configuration
[[ ! -f ~/.p10k.zsh ]] || source ~/.p10k.zsh # To customize prompt, run `p10k configure` or edit ~/.p10k.zsh.
# END SECTION Powerlevel10k autogenerated configuration

# START SECTION zsh-autosuggestions
if [[ -f "$HOMEBREW_PREFIX/share/zsh-autosuggestions/zsh-autosuggestions.zsh" ]]; then
    source $HOMEBREW_PREFIX/share/zsh-autosuggestions/zsh-autosuggestions.zsh
fi
# END SECTION zsh-autosuggestions


# START SECTION zsh-history
HISTFILE=~/.zsh_history
HISTSIZE=999999999
SAVEHIST=$HISTSIZE
setopt INC_APPEND_HISTORY
export HISTTIMEFORMAT="[%F %T] "
setopt EXTENDED_HISTORY
setopt HIST_FIND_NO_DUPS
# END SECTION zsh-history

export PATH="$HOME/.local/bin:$PATH"
{{- if eq .chezmoi.os "darwin" }}
export PATH="$HOMEBREW_PREFIX/opt/coreutils/libexec/gnubin:$PATH"
export PATH="$HOMEBREW_PREFIX/opt/findutils/libexec/gnubin:$PATH"
export PATH="$HOMEBREW_PREFIX/opt/gnu-sed/libexec/gnubin:$PATH"
{{- end }}


# START SECTION gpg
export GPG_TTY=$(tty)
# END SECTION gpg
# >>> conda initialize >>> (lazy-loaded)
__conda_lazy_setup() {
    __conda_setup="$('$CONDA_BASE/bin/conda' 'shell.zsh' 'hook' 2> /dev/null)"
    if [ $? -eq 0 ]; then
        eval "$__conda_setup"
    else
        if [ -f "$CONDA_BASE/etc/profile.d/conda.sh" ]; then
            . "$CONDA_BASE/etc/profile.d/conda.sh"
        else
            export PATH="$CONDA_BASE/bin:$PATH"
        fi
    fi
    unset __conda_setup
}

# Only initialize conda when actually needed
conda() {
    unfunction conda
    __conda_lazy_setup
    conda "$@"
}
# <<< conda initialize <

# START SECTION fzf
# fzf Shell Integration
if command -v fzf &> /dev/null; then
    source <(fzf --zsh)
fi
# END SECTION fzf

# START SECTION go
export GOPATH=$HOME/go
export PATH=$PATH:$GOPATH/bin
# END SECTION go


# === FZF-TAB CONFIGURATION ===
export FZF_COMMON_OPTS="--preview-window='right:50%,<100(hidden)' --bind='ctrl-/:toggle-preview'"
export FZF_DEFAULT_COMMAND='fd --type f --strip-cwd-prefix --hidden --exclude .git --exclude node_modules'
export FZF_CTRL_T_COMMAND="$FZF_DEFAULT_COMMAND"
export FZF_CTRL_T_OPTS="
  $FZF_COMMON_OPTS
  --preview 'fzf-preview.sh {} \$FZF_PREVIEW_COLUMNS \$FZF_PREVIEW_LINES'
  --header 'C-/ to toggle preview'
"
export FZF_ALT_C_OPTS="--preview 'eza --tree --level=2 --color=always {} | head -200'"
export FZF_PREVIEW_OPTS="--preview-window='right:50%,border-left,<100(hidden),wrap'"
zstyle ':fzf-tab:*' use-cache true
zstyle ':fzf-tab:*' cache-path "$HOME/.cache/fzf-tab"
# === IMPROVED FZF-TAB PREVIEW (Handles Binaries) ===
zstyle ':fzf-tab:complete:*:*' fzf-preview 'fzf-preview.sh $realpath $FZF_PREVIEW_COLUMNS $FZF_PREVIEW_LINES'

# 1. Use a popup window (instead of taking over the whole screen)
zstyle ':fzf-tab:*' fzf-flags \
  --height=70% \
  --layout=reverse \
  --border \
  --preview-window='right:60%,<100(hidden)'

zstyle ':fzf-tab:*' switch-group ',' '.'
zstyle ':completion:*' list-colors ${(s.:.)LS_COLORS}

# 3. Enable PREVIEW for 'bd' commands
zstyle ':fzf-tab:complete:bd:*' fzf-preview 'bd show $word'
zstyle ':fzf-tab:complete:bd:*' fzf-preview-window 'right:60%,<100(hidden)'
