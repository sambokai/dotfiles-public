{{- $name := promptStringOnce . "name" "What is your full name" -}}
{{- $email := promptStringOnce . "email" "What is your email address" -}}
# chezmoi configuration

[data]
    name = {{ $name | toToml }}
    email = {{ $email | toToml }}

[diff]
    command = "delta"
    paging = "always"

{{- if eq .chezmoi.os "linux" }}
# Pre-authenticate sudo on Linux to reduce password prompts
[hooks.apply.pre]
    command = "sudo"
    args = ["-v"]
{{- end }}

{{- if eq .chezmoi.os "darwin" }}
[merge]
    command = "bash"
    args = [
        "-c",
        "cp {{ `{{ .Target | quote }}` }} {{ `{{ printf \"%s.base\" .Target | quote }}` }} && code --new-window --wait --merge {{ `{{ .Destination | quote }}` }} {{ `{{ .Target | quote }}` }} {{ `{{ printf \"%s.base\" .Target | quote }}` }} {{ `{{ .Source | quote }}` }}"
    ]
{{- end }}
