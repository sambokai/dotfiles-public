#!/bin/bash
set -euo pipefail

# Install zsh if not present

{{- if eq .chezmoi.os "darwin" }}

# macOS: zsh is preinstalled
if command -v zsh &>/dev/null; then
    echo "zsh is already installed on macOS"
else
    echo "Error: zsh not found on macOS (this should not happen)"
    exit 1
fi

{{- else if eq .chezmoi.os "linux" }}

# Linux: check and install via apt
if command -v zsh &>/dev/null; then
    echo "zsh is already installed"
else
    echo "Installing zsh via apt..."
    sudo apt update
    sudo apt install -y zsh
fi

{{- end }}
