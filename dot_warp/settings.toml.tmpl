[appearance]
spacing = "normal"

[appearance.themes]
theme = "adeberry"
system_theme = false

[appearance.vertical_tabs]
compact_subtitle = "command"
display_granularity = "tabs"
show_diff_stats = false
enabled = true
view_mode = "compact"
show_details_on_hover = true
use_latest_prompt_as_title = false
show_pr_link = false
primary_info = "working_directory"
hide_title_bar_search_bar = true
show_panel_in_restored_windows = true
tab_item_mode = "focused_session"

[appearance.tabs]
tab_close_button_position = "right"
preserve_active_tab_color = false
workspace_decoration_visibility = "always_show"
show_indicators_button = true

[appearance.tabs.directory_tab_colors]
"{{ .chezmoi.homeDir }}/.local/share/chezmoi" = "unassigned"

[appearance.tabs.header_toolbar_chip_selection]

[appearance.tabs.header_toolbar_chip_selection.custom]
left = ["tabs_panel"]
right = ["tools_panel", "notifications_mailbox"]

[appearance.text]
notebook_font_size = 14.0
font_size = 11.0
line_height_ratio = 1.2000000476837158
match_ai_font = true
ai_font_name = "Hack"
enforce_minimum_contrast = "only_named_colors"

[appearance.blocks]
show_block_dividers = true
show_jump_to_bottom_of_block_button = false

[appearance.input]
input_mode = "waterfall"

[appearance.cursor]
cursor_display_type = "block"
cursor_blink = "enabled"

[appearance.icon]
app_icon = "default"

[appearance.window]
zoom_level = 125
override_opacity = 100
override_blur = 1

[appearance.panes]
should_dim_inactive_panes = false
focus_pane_on_hover = false

[general]
mouse_scroll_multiplier = 4.0
snackbar_enabled = false
restore_session = true
show_warning_before_quitting = false
show_changelog_after_update = true
link_tooltip = false
default_session_mode = "terminal"
preserve_input_focus_on_block_selection = true

[general.undo_close]
grace_period = 120

[agents]
cloud_conversation_storage_enabled = false

[agents.third_party]
should_render_cli_agent_toolbar = true

[agents.third_party.cli_agent_toolbar_chip_selection_setting]

[agents.third_party.cli_agent_toolbar_chip_selection_setting.custom]
left = [{ context_chip = "hostname" }]
right = [
  { context_chip = "working_directory" },
  { context_chip = "shell_git_branch" },
  { context_chip = "github_pull_request" },
]

[agents.warp_agent]
is_any_ai_enabled = true

[agents.warp_agent.other]
agent_attribution_enabled = false
show_agent_notifications = true
should_render_use_agent_toolbar_for_user_commands = false
show_conversation_history = false
should_show_oz_updates_in_zero_state = false

[agents.warp_agent.input]
nld_in_terminal_enabled = true
ai_auto_detection_enabled = false
include_agent_commands_in_history = true
show_agent_tips = false

[agents.warp_agent.input.agent_toolbar_chip_selection_setting]

[agents.warp_agent.input.agent_toolbar_chip_selection_setting.custom]
left = [
  "voice_input",
  { context_chip = "ssh" },
  { context_chip = "working_directory" },
  { context_chip = "shell_git_branch" },
  { context_chip = "github_pull_request" },
  "nld_toggle",
]
right = ["context_window_usage", "model_selector", "share_session", "file_attach"]

[agents.warp_agent.active_ai]
enabled = true
agent_mode_query_suggestions_enabled = true
intelligent_autosuggestions_enabled = true
git_operations_autogen_enabled = true
code_suggestions_enabled = true

[agents.profiles]
agent_mode_coding_permissions = "always_allow_reading"

[agents.voice]
voice_input_toggle_key = "none"
voice_input_enabled = false

[agents.execution_profiles]

[agents.execution_profiles.default]
apply_code_diffs = "agent_decides"
ask_user_question = "always_ask"
autosync_plans_to_warp_drive = false
command_allowlist = []
command_denylist = [
  'bash(\s.*)?',
  'fish(\s.*)?',
  'pwsh(\s.*)?',
  'sh(\s.*)?',
  'zsh(\s.*)?',
  'curl(\s.*)?',
  'eval(\s.*)?',
  'exec(\s.*)?',
  'source(\s.*)?',
  'wget(\s.*)?',
  'dig(\s.*)?',
  'nslookup(\s.*)?',
  'host(\s.*)?',
  'ssh(\s.*)?',
  'scp(\s.*)?',
  'rsync(\s.*)?',
  'telnet(\s.*)?',
  'rm(\s.*)?',
]
computer_use = "never"
directory_allowlist = []
execute_commands = "always_ask"
mcp_allowlist = []
mcp_denylist = []
mcp_permissions = "agent_decides"
name = "Default"
read_files = "agent_decides"
run_agents = "always_ask"
web_search_enabled = true
write_to_pty = "always_allow"

[code]

[code.editor]
open_file_editor = "warp"
show_global_search = true
show_project_explorer = false
show_code_review_button = false

[code.indexing]
agent_mode_codebase_context = true
agent_mode_codebase_context_auto_indexing = true

[warp_drive]
enabled = false

[terminal]
show_terminal_zero_state_block = false
use_audible_bell = true
osc52_clipboard_access = "write_only"

[terminal.input]
input_box_type_setting = "universal"
honor_ps1 = false
error_underlining_enabled = true
show_terminal_input_message_bar = false
at_context_menu_in_terminal_mode = false
show_hint_text = false
completions_open_while_typing = true
alias_expansion_enabled = false
enable_slash_commands_in_terminal = false

[terminal.input.autosuggestions]
keybinding_hint = false

[terminal.input.extra_meta_keys]
left_alt = true
right_alt = false

[account]
is_settings_sync_enabled = true

[privacy]
crash_reporting_enabled = false
telemetry_enabled = false

[cloud_platform]

[cloud_platform.third_party_api_keys]
can_use_warp_credits_with_byok = false

[notifications]
toast_duration_secs = 8

[notifications.preferences]
is_agent_task_completed_enabled = true
is_long_running_enabled = true
is_needs_attention_enabled = true
is_password_prompt_enabled = true
long_running_threshold = 30
mode = "enabled"
play_notification_sound = true

[session]

[session.working_directory_config]
advanced_mode = true
global = { custom_dir = "", mode = "previous_dir" }
new_tab = { custom_dir = "", mode = "previous_dir" }
new_window = { custom_dir = "", mode = "previous_dir" }
split_pane = { custom_dir = "", mode = "previous_dir" }

[experimental]
async_find_enabled = true

[global_hotkey]

[global_hotkey.dedicated_window]
enabled = false

[global_hotkey.toggle_all_windows]
enabled = false

[warpify]

[warpify.ssh]
enable_ssh_warpification = true
reuse_existing_control_master = true
