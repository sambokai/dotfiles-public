#!/bin/bash
set -euo pipefail
# Re-run only when Brewfile template source changes.
# brewfile-template-sha256: {{ include "dot_Brewfile.tmpl" | sha256sum }}

# Set up Homebrew PATH for Linux
{{- if eq .chezmoi.os "linux" }}
if [[ -x "/home/linuxbrew/.linuxbrew/bin/brew" ]]; then
    eval "$(/home/linuxbrew/.linuxbrew/bin/brew shellenv)"
fi
{{- end }}

# Check if brew command exists
if ! command -v brew &> /dev/null; then
    echo "Homebrew not found. Skipping brew bundle."
    exit 0
fi

# Check if Brewfile exists
BREWFILE="{{ .chezmoi.homeDir }}/.Brewfile"
if [[ ! -f "$BREWFILE" ]]; then
    echo "Brewfile not found at $BREWFILE. Skipping brew bundle."
    exit 0
fi

# Trust any untrusted taps before running bundle
# (prevents "untrusted tap" errors from partially-failed prior runs)
while IFS= read -r tap; do
    brew trust "$tap" 2>/dev/null || true
done < <(brew tap 2>/dev/null || true)

# Run brew bundle with concise output
echo "Homebrew: syncing Brewfile..."
brew bundle --global --quiet
echo "Homebrew: sync complete."
echo "Homebrew: run 'brew bundle check --global' to verify everything is installed."
